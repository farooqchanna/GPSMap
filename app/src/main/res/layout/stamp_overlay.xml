<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stampRoot" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="#00141414">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="26dp"
        android:layout_gravity="end" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp"
        android:paddingBottom="3dp" android:background="#991A1A1A">
        <ImageView android:layout_width="16dp" android:layout_height="16dp"
            android:src="@android:drawable/ic_menu_camera" android:tint="#FFFFFF"
            android:contentDescription="Camera map pin"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:text="GPS Map Camera" android:textColor="#FFFFFF"
            android:textSize="11sp" android:fontFamily="sans-serif"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="145dp" android:orientation="horizontal" android:background="#88141414">
        <FrameLayout android:layout_width="145dp" android:layout_height="145dp">
            <ImageView android:id="@+id/stampMapImage" android:layout_width="match_parent"
                android:layout_height="match_parent" android:scaleType="centerCrop"
                android:contentDescription="Satellite map thumbnail"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|start" android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp" android:text="Google" android:textColor="#FFFFFF"
                android:textSize="16sp" android:textStyle="bold"
                android:shadowColor="#CC000000" android:shadowRadius="3"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/stampTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="City, State, Country 🇵🇰"
                android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="sans-serif"
                android:shadowColor="#80000000" android:shadowRadius="2"/>
            <TextView android:id="@+id/stampAddress" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:text="Plus code, street, city, state, country" android:textColor="#F5F5F5"
                android:textSize="14sp" android:fontFamily="sans-serif"
                android:shadowColor="#80000000" android:shadowRadius="2" android:maxLines="2"/>
            <TextView android:id="@+id/stampCoordinates" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:text="Lat 0.000000° Long 0.00000°" android:textColor="#F5F5F5"
                android:textSize="14sp" android:fontFamily="sans-serif"
                android:shadowColor="#80000000" android:shadowRadius="2"/>
            <TextView android:id="@+id/stampDateTime" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:text="Monday, 01/01/2026 12:00 PM GMT +05:00" android:textColor="#F5F5F5"
                android:textSize="14sp" android:fontFamily="sans-serif"
                android:shadowColor="#80000000" android:shadowRadius="2"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
