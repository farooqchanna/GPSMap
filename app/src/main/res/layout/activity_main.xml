<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <!-- ===================== Header ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_logo_ring">

            <!-- Existing app lens logo (unchanged asset) -->
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_gps_camera_lens_logo" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_bright"
                android:textSize="19sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Geotag your photos with a map stamp"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="v1.0"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===================== Photo preview card ===================== -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_preview_card">

        <ImageView
            android:id="@+id/photoPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:contentDescription="Selected photo preview" />

        <include
            android:id="@+id/stampPreview"
            layout="@layout/stamp_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:drawableTop="@drawable/ic_empty_state"
            android:drawablePadding="18dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:lineSpacingExtra="4dp"
            android:text="No photo yet\nCapture or choose a photo to begin"
            android:textColor="@color/text_faint"
            android:textSize="15sp" />
    </FrameLayout>

    <!-- ===================== Bottom action bar ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_bar"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">

        <!-- Camera-app style row: Gallery | SHUTTER | Stamp settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Gallery (left thumb) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageButton
                    android:id="@+id/galleryButton"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_round_icon"
                    android:contentDescription="Choose from gallery"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_action_gallery"
                    android:tint="@color/btn_text_light" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Gallery"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Shutter (centre, biggest) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageButton
                    android:id="@+id/captureButton"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:background="@drawable/bg_shutter"
                    android:contentDescription="Take photo"
                    android:padding="26dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_action_camera"
                    android:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Camera"
                    android:textColor="@color/text_bright"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Stamp settings (right thumb) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageButton
                    android:id="@+id/configureButton"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_round_icon"
                    android:contentDescription="Configure stamp"
                    android:enabled="false"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_action_tune"
                    android:tint="@color/btn_text_light" />

                <TextView
                    android:id="@+id/configureLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:alpha="0.45"
                    android:text="Stamp"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_save"
            android:drawableStart="@drawable/ic_action_save"
            android:drawablePadding="10dp"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="40dp"
            android:text="Save Stamped Photo"
            android:textColor="@color/btn_text_on_amber"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:enabled="false" />
    </LinearLayout>
</LinearLayout>
