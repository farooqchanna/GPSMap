<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <!-- ============ Location ============ -->
        <TextView style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOCATION" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/searchPlaceButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_outline"
            android:drawableStart="@drawable/ic_action_search"
            android:drawablePadding="10dp"
            android:gravity="center"
            android:text="Search a place"
            android:textColor="@color/btn_text_light"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Search a place, or tap the map to choose a location"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#10141D"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/surface_stroke_soft"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <org.osmdroid.views.MapView
                android:id="@+id/locationMap"
                android:layout_width="match_parent"
                android:layout_height="210dp" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/useGpsButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_tonal"
            android:drawableStart="@drawable/ic_action_gps"
            android:drawablePadding="10dp"
            android:gravity="center"
            android:text="Use current GPS location"
            android:textColor="@color/btn_text_light"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />

        <TextView
            android:id="@+id/locationSummary"
            style="@style/InfoBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Choose a location" />

        <!-- ============ Date & time ============ -->
        <TextView style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="DATE &amp; TIME" />

        <CheckBox
            android:id="@+id/useCurrentTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="44dp"
            android:text="Use current date and time"
            android:textColor="@color/text_bright"
            android:textSize="14sp"
            android:checked="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/pickDateButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="46dp"
                android:background="@drawable/bg_button_outline"
                android:text="Choose date"
                android:textColor="@color/btn_text_light"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/pickTimeButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="46dp"
                android:background="@drawable/bg_button_outline"
                android:text="Choose time"
                android:textColor="@color/btn_text_light"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/dateTimeSummary"
            style="@style/InfoBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <!-- ============ Stamp appearance ============ -->
        <TextView style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="STAMP APPEARANCE" />

        <TextView style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Font size" />

        <SeekBar
            android:id="@+id/stampFontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="22"
            android:progress="8" />

        <TextView
            android:id="@+id/fontSizeValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="22 sp"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Map box size" />

        <SeekBar
            android:id="@+id/stampMapSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="110"
            android:progress="55" />

        <TextView
            android:id="@+id/mapSizeValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="145 dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Font color" />

        <Spinner
            android:id="@+id/stampFontColor"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp" />

        <!-- ============ Show on stamp ============ -->
        <TextView style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="SHOW ON STAMP" />

        <CheckBox
            android:id="@+id/showAddressLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="44dp"
            android:text="Show address / area"
            android:textColor="@color/text_bright"
            android:textSize="14sp"
            android:checked="true" />

        <CheckBox
            android:id="@+id/showCoordinates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="Show latitude and longitude"
            android:textColor="@color/text_bright"
            android:textSize="14sp"
            android:checked="true" />

        <CheckBox
            android:id="@+id/showDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="Show date and time"
            android:textColor="@color/text_bright"
            android:textSize="14sp"
            android:checked="true" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/applyOptionsButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_primary"
            android:drawableStart="@drawable/ic_action_tune"
            android:drawablePadding="10dp"
            android:gravity="center"
            android:text="Preview stamp"
            android:textColor="@color/btn_text_light"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />
    </LinearLayout>
</ScrollView>
