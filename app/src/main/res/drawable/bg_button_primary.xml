<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/btn_disabled_fill" />
            <stroke android:width="1dp" android:color="#2A3140" />
        </shape>
    </item>
    <item>
        <ripple android:color="#4DFFFFFF">
            <item>
                <shape>
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="0"
                        android:startColor="#4FB2FF"
                        android:centerColor="#2D9CFF"
                        android:endColor="#1967D2" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
