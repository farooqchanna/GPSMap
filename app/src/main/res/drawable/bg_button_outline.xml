<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/btn_disabled_fill" />
            <stroke android:width="1dp" android:color="#2A3140" />
        </shape>
    </item>
    <item>
        <ripple android:color="#33FFFFFF">
            <item>
                <shape>
                    <corners android:radius="16dp" />
                    <solid android:color="#1A2030" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#3A4256" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
